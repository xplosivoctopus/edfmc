# EDFM API configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored; this template is not, so
# it must never contain a real secret.

EDFM_DATABASE_URL=postgresql://user:password@localhost/edfm_dev

# Required. Keys the identity hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it re-anonymises every stored hash.
EDFM_IDENTITY_SALT=

# --------------------------------------------------------------- Discord

# Off unless this is true AND a webhook is set.
EDFM_DISCORD_ENABLED=false

# SECRET. Anyone holding this can post to the channel. Never commit it, never
# paste it into an issue, and never put it in the desktop client.
# Format: https://discord.com/api/webhooks/<id>/<token>
# The webhook must target a FORUM channel, not a text channel.
EDFM_DISCORD_WEBHOOK=

# Forum tag IDs. Discord applies tags by snowflake id, not by display name, and
# ids differ per channel -- so they are configuration, not constants.
# To find one: Discord Settings > Advanced > Developer Mode, then right-click
# the tag in the Forum channel settings and Copy ID.
# An unmapped category is simply not tagged; it never fails the report.
#
# Either form works:
#   EDFM_DISCORD_FORUM_TAGS=Station=123,Service=456,Needs Review=789
#   EDFM_DISCORD_FORUM_TAGS={"Station":"123","Service":"456"}
#
# Recognised names: Station, Settlement, System, Commodity, Service,
# Outfitting, Shipyard, Engineer, Colonisation, Needs Review, Confirmed, Resolved
EDFM_DISCORD_FORUM_TAGS=

# What to do with a finding that may name something the commander's own game
# has not revealed. `suppress` posts nothing; `redact` posts a locationless
# stub. A Forum post is public and permanent, so the default is suppress.
EDFM_DISCORD_SPOILER_POLICY=suppress

# Post one message when a discrepancy stops disagreeing.
EDFM_DISCORD_POST_RESOLUTIONS=true

# Name the commander in the Forum post. Off by default: being credited on a
# contribution list is a different decision from being named in a public
# moderation thread.
EDFM_DISCORD_INCLUDE_COMMANDER=false

# --------------------------------------------------------------- admin

# SECRET. Guards /v1/admin/*, which can post to the live Discord channel.
# Unset means those routes are not registered at all.
# Generate the same way as the identity salt.
EDFM_ADMIN_TOKEN=

# --------------------------------------------------------------- server

# Which peers may be believed about X-Forwarded-For. `loopback` matches the
# documented topology, where nginx terminates TLS and proxies to 127.0.0.1.
#
# NEVER set this to `true`. req.ip keys the rate limiter and the stored source
# hash, so trusting the header from any peer lets a remote client choose the
# identity that both of those controls are based on.
EDFM_TRUST_PROXY=loopback

EDFM_PORT=8787
EDFM_HOST=127.0.0.1
EDFM_RATE_LIMIT_PER_MINUTE=60
