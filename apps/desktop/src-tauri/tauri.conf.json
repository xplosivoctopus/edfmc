{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EDFM Companion",
  "version": "0.1.0",
  "identifier": "com.edfieldmanual.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EDFM Companion",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "EDFM Overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visible": false,
        "width": 800,
        "height": 600
      },
      {
        "label": "capture",
        "url": "capture.html",
        "title": "Screenshot",
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "center": true,
        "focus": true,
        "visible": false,
        "width": 520,
        "height": 660
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
