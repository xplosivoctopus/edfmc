{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Journal access goes through narrow custom commands rather than a broad filesystem permission.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.edfieldmanual.com/*"
        },
        {
          "url": "https://eddn.edcd.io:4430/upload/"
        }
      ]
    },
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-center",
    "core:window:allow-set-always-on-top",
    "core:webview:allow-get-all-webviews",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**/*.png"
        },
        {
          "path": "**/*.jpg"
        },
        {
          "path": "**/*.jpeg"
        },
        {
          "path": "**/*.bmp"
        }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        {
          "path": "**"
        }
      ]
    }
  ]
}
